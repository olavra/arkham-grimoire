# Vercel
.vercel

# OS
Thumbs.db
desktop.ini
.DS_Store

# Editors
.vscode/
.idea/
*.swp

# Logs
*.log
npm-debug.log*

# Node (not used yet, but keep out if added)
node_modules/

# Pack-art source images (large, 1-1.5MB each): kept locally to feed
# docs/regen-packart.py, never pushed. Only the small generated tiles
# in img/packs-art/tiles/ are tracked, since that's what the page loads.
img/packs-art/*
!img/packs-art/tiles/

# Per-user Claude Code settings, not project config.
.claude/settings.local.json

# Local mirror of the ArkhamDB card scans, filled by docs/fetch-cardart.py:
# ~7600 files, ~850 MB, re-downloadable at any time. The manifest is what makes
# a re-run incremental, so it stays with the images rather than in the repo.
data/cardart/

# Upstream card data, cloned by scripts/fetch-data.py. Generated and never
# edited: our changes live in data/overlay/. The commit used is recorded in
# data/upstream.lock, which IS committed.
data/upstream/

# Build output.
public/data/
